[Unit]
Description=llama.cpp ASR server (Qwen3-ASR-1.7B, CPU)
After=network.target

[Service]
Type=simple
# TODO: 改成运行服务的实际用户（建议非 root），如 User=asr
User=asr
# TODO: 按实际部署路径修改（三处 /opt/asrdeploy）
WorkingDirectory=/opt/asrdeploy
EnvironmentFile=/opt/asrdeploy/.env
Environment=LD_LIBRARY_PATH=/opt/asrdeploy/bin/llama/lib:/opt/asrdeploy/bin/llama
ExecStart=/opt/asrdeploy/bin/llama/llama-server \
  -m /opt/asrdeploy/${MODEL_FILE} \
  --mmproj /opt/asrdeploy/${MMPROJ_FILE} \
  --host 127.0.0.1 --port ${LLAMA_PORT} \
  -t ${LLAMA_THREADS} -c ${LLAMA_CTX}
Restart=always
RestartSec=5
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
