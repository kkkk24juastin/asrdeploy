[Unit]
Description=Qwen3-ASR OpenAI-compatible API proxy
After=llama-asr.service
Wants=llama-asr.service

[Service]
Type=simple
# TODO: 改成运行服务的实际用户（与 llama-asr.service 一致）
User=asr
# TODO: 按实际部署路径修改
WorkingDirectory=/opt/asrdeploy/proxy
EnvironmentFile=/opt/asrdeploy/.env
ExecStart=/opt/asrdeploy/venv/bin/uvicorn asr_proxy:app \
  --host ${PROXY_HOST} --port ${PROXY_PORT}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
