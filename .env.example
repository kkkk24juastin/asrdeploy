# asrdeploy 配置 — 复制为 .env 后按需修改（Docker 与裸机部署共用）

# ---- 对外服务 ----
# Docker 部署时为宿主机映射端口；裸机部署时为代理监听端口
PROXY_PORT=8000
# 生产环境务必设置（客户端使用 Authorization: Bearer <key>）
ASR_API_KEY=

# ---- 模型下载 ----
# 国内镜像: https://hf-mirror.com ｜ 可直连 HuggingFace 时: https://huggingface.co
HF_ENDPOINT=https://hf-mirror.com

# ---- 性能 ----
LLAMA_THREADS=16
LLAMA_CTX=16384

# ================= 以下仅裸机（非 Docker）部署使用 =================
PROXY_HOST=127.0.0.1
LLAMA_PORT=8081
MODEL_FILE=models/Qwen3-ASR-1.7B-Q8_0.gguf
MMPROJ_FILE=models/mmproj-Qwen3-ASR-1.7B-Q8_0.gguf
UPSTREAM_URL=http://127.0.0.1:8081
