# asrdeploy 配置 — 复制为 .env 后按需修改（docker compose 使用）

# ---- 对外服务 ----
# 宿主机映射端口（容器内代理固定 8000）
PROXY_PORT=8000
# 生产环境务必设置（客户端使用 Authorization: Bearer <key>）
ASR_API_KEY=

# ---- 模型 ----
# 美国/海外服务器: https://huggingface.co ｜ 国内服务器: https://hf-mirror.com
HF_ENDPOINT=https://huggingface.co
# 默认 Q8_0（质量优先）。如需切换量化版本，三个变量需同时修改，例如：
#   加速档 Q4_K_M（约快 25~40%，WER 约 +0.2~0.4pp）：
#   HF_REPO=mradermacher/Qwen3-ASR-1.7B-GGUF
#   MODEL_FILE=Qwen3-ASR-1.7B.Q4_K_M.gguf
#   MMPROJ_FILE=Qwen3-ASR-1.7B.mmproj-Q8_0.gguf    ← 编码器必须 Q8_0，勿用 Q4
HF_REPO=ggml-org/Qwen3-ASR-1.7B-GGUF
MODEL_FILE=Qwen3-ASR-1.7B-Q8_0.gguf
MMPROJ_FILE=mmproj-Qwen3-ASR-1.7B-Q8_0.gguf

# ---- 性能 ----
LLAMA_THREADS=16
LLAMA_CTX=16384
# llama-server 附加参数：KV cache 8bit 量化 + Flash Attention
# （长音频提速 10~20%，识别质量无损；如遇启动异常，改为 LLAMA_EXTRA_ARGS= 留空）
LLAMA_EXTRA_ARGS=--cache-type-k q8_0 --cache-type-v q8_0 -fa on
