# asrdeploy 配置 — 复制为 .env 后按需修改（docker compose 使用）

# ---- 对外服务 ----
# 宿主机映射端口（容器内代理固定 8000）
PROXY_PORT=8000
# 生产环境务必设置（客户端使用 Authorization: Bearer <key>）
ASR_API_KEY=

# ---- 模型下载 ----
# 美国/海外服务器: https://huggingface.co ｜ 国内服务器: https://hf-mirror.com
HF_ENDPOINT=https://huggingface.co

# ---- 性能 ----
LLAMA_THREADS=16
LLAMA_CTX=16384
